{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3.1-flash-lite",
  "small_model": "google/gemini-3.5-flash-lite",
  "permissions": [
    { "action": "shell", "resource": "*git commit*", "effect": "ask" },
    { "action": "shell", "resource": "*git push*", "effect": "ask" },
    { "action": "shell", "resource": "*taskkill*", "effect": "ask" },
    { "action": "shell", "resource": "*pkill*", "effect": "ask" },
    { "action": "shell", "resource": "*Stop-Process*", "effect": "ask" },
    { "action": "shell", "resource": "*killall*", "effect": "ask" },
    { "action": "shell", "resource": "*rm -rf*", "effect": "ask" }
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}
