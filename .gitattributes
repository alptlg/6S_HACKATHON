# Keep shell scripts, workflows and manifests LF on every OS, so a Windows clone can run
# the deploy scripts and manifest checksums match on Connect.
* text=auto
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.R text eol=lf
*.py text eol=lf
manifest.json text eol=lf
*.png binary
*.gz binary
